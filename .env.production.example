# Mẫu biến môi trường cho production — viconnect.manai.vn
# Copy thành .env trên VPS và điền giá trị thật. KHÔNG commit file .env thật lên git.
#
#   cp .env.production.example .env

# Connection string PostgreSQL production (tự host trên VPS hoặc managed
# Neon/Supabase/RDS...). Đổi user/password/host/dbname cho khớp bước tạo DB.
DATABASE_URL="postgresql://viconnect:THAY_BANG_MAT_KHAU_MANH@localhost:5432/viconnect_prod?schema=public"

# Sinh giá trị ngẫu nhiên đủ mạnh: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"

# Bắt buộc khi chạy sau reverse proxy (Nginx) như hướng dẫn trong docs/DEPLOYMENT.md
AUTH_TRUST_HOST="true"

# Domain chính thức — dùng đúng scheme https vì đã có SSL qua certbot
NEXTAUTH_URL="https://viconnect.manai.vn"
