# Mẫu biến môi trường cho production — viconnect.manai.vn
# Copy thành .env trên VPS và điền giá trị thật. KHÔNG commit file .env thật lên git.
#
#   cp .env.production.example .env

# Connection string PostgreSQL production (tự host trên VPS hoặc managed
# Neon/Supabase/RDS...). Đổi user/password/host/dbname cho khớp bước tạo DB.
DATABASE_URL="postgresql://viconnect:THAY_BANG_MAT_KHAU_MANH@localhost:5432/viconnect_prod?schema=public"

# Sinh giá trị ngẫu nhiên đủ mạnh: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"

# Bắt buộc khi chạy sau reverse proxy (Nginx) như hướng dẫn trong docs/DEPLOYMENT.md
AUTH_TRUST_HOST="true"

# Domain chính thức — dùng đúng scheme https vì đã có SSL qua certbot
NEXTAUTH_URL="https://viconnect.manai.vn"

# ---- Tích hợp ORCID OAuth (cấu phần 01 — VC-NV-011 Mục 9.1) ----
# Tuỳ chọn: không set thì nút "Kết nối ORCID qua OAuth thật" tự ẩn, chỉ còn
# nhập ORCID thủ công (trạng thái ENTERED, không xác thực).
# Đăng ký ứng dụng tại https://orcid.org/developer-tools (cần tài khoản ORCID
# của TỔ CHỨC, chủ repo tự đăng ký — không phải bước AI thực hiện được), lấy
# Client ID/Secret rồi khai báo redirect URI đúng domain:
#   https://viconnect.manai.vn/api/integrations/orcid/callback
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
# "production" (mặc định) hoặc "sandbox" khi thử nghiệm với sandbox.orcid.org
ORCID_ENV="production"

# ---- Polite pool cho OpenAlex/Crossref (tuỳ chọn) ----
# Không bắt buộc (API mở, không cần key) nhưng OpenAlex khuyến nghị kèm email
# liên hệ để giảm rủi ro bị giới hạn tốc độ khi gọi nhiều.
OPENALEX_POLITE_POOL_EMAIL=""
