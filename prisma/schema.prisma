// VI CONNECT — Phase 1 (Nam 1) data model
// Mapped to the "5 domains" the proposal itself proposes to consolidate the 11 modules into:
// A. CONNECT (Organization, ExpertProfile, membership)
// B. DISCOVER & MATCH (Need, Supply, Match, Challenge, Solution)
// D. EXECUTE (Project, Milestone, Deliverable, Agreement)
// E. IMPACT (KpiSnapshot)
// C. MOBILIZE (FundingSource/FundingApplication) intentionally left out of Phase 1 —
// documented as backlog in README per the roadmap's own stage-gate principle.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- CONNECT: identity & ecosystem ----------

enum OrganizationType {
  HOI_THANH_VIEN // hoi nganh / lien hiep hoi dia phuong
  TO_CHUC_KHCN // vien/trung tam truc thuoc
  DOANH_NGHIEP
  QUY_DAU_TU
  CO_QUAN_QUAN_LY
  KHAC
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  shortName   String?
  type        OrganizationType
  province    String?
  description String?
  website     String?
  status      OrgStatus        @default(PENDING)
  parentId    String?
  parent      Organization?    @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[]   @relation("OrgHierarchy")

  identifiers    Identifier[]
  members        ExpertProfile[]
  users          User[]
  supplies       Supply[]
  needs          Need[]
  challenges     Challenge[]
  fundingSources FundingSource[]
  affiliations   Affiliation[]
  publications   Publication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
}

enum Role {
  SUPERADMIN // quan tri toan he thong
  ADMIN // delegated admin cua 1 hoi/to chuc (10.6)
  EXPERT
  ENTERPRISE
  VIEWER
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(VIEWER)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  expertProfile  ExpertProfile?
  profileClaims  ProfileClaim[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditLogs   AuditLog[]
  evaluations Evaluation[]
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileStatus {
  UNCLAIMED // candidate profile, chua co nguoi nhan (ADR-0001 Muc 10)
  CLAIMED
  SUSPENDED
  RETIRED
  MERGED
}

model ExpertProfile {
  id             String       @id @default(cuid())
  userId         String?      @unique // null = candidate profile chua duoc claim (ADR-0001 Muc 10)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  profileStatus ProfileStatus @default(CLAIMED)

  title           String? // hoc ham/hoc vi
  headline        String?
  bio             String?
  fields          String[] // linh vuc chuyen mon (taxonomy code)
  skills          String[]
  experienceYears Int?
  publications    Int?     @default(0)
  patents         Int?     @default(0)
  avatarPath      String? // duong dan tuong doi trong uploads/, phuc vu qua route co xac thuc
  avatarName      String?

  // Field-level visibility: map fieldPath -> FieldVisibility (VC-NV-011 Muc 15, ADR-0001 Muc 10).
  // Khong co key = ap dung mac dinh Muc 15.2 o tang domain, khong phai PUBLIC ngam dinh.
  visibility Json?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNote   String?

  identifiers     Identifier[]
  supplies        Supply[]
  matchesAsExpert Match[]      @relation("ExpertMatches")

  affiliations        Affiliation[]
  consents            Consent[]
  externalConnections ExternalConnection[]
  fieldProposals      FieldProposal[]
  expertise           Expertise[]
  capabilities        Capability[]
  claims              ProfileClaim[]
  identityMatchesAsA  IdentityMatch[]      @relation("IdentityMatchA")
  identityMatchesAsB  IdentityMatch[]      @relation("IdentityMatchB")
  mergesAsSource      MergeHistory[]       @relation("MergeSource")
  mergesAsTarget      MergeHistory[]       @relation("MergeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([profileStatus])
}

enum IdentifierType {
  VAST_ID
  ORCID
  ISNI
  ROR
  DOI
}

model Identifier {
  id              String         @id @default(cuid())
  type            IdentifierType
  value           String
  expertProfileId String?
  expertProfile   ExpertProfile? @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([type, value])
}

// ---------- CONNECT: identity & profile core (cau phan 01, VC-NV-011 v2.0) ----------
// Tam chot theo docs/adr/0001-ho-so-dinh-danh-tam-chot-tham-so.md — chua phai
// quyet dinh chinh thuc cua Product Owner.

model Affiliation {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  department      String?
  position        String? // chuc danh, free-text (ADR-0001 Muc 6)
  affiliationType String? // vd EMPLOYEE|EXPERT|CONSULTANT|MEMBER, free-text (ADR-0001 Muc 6)
  isPrimary       Boolean   @default(false)
  startDate       DateTime?
  endDate         DateTime?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  source             String? // "SELF" | "ORGANIZATION" | ten nguon ngoai

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertProfileId])
  @@index([organizationId])
}

enum ExternalSourceType {
  ORCID
  OPENALEX
  CROSSREF
  ROR
  ORG_WEBSITE
  INTERNAL
  COMMERCIAL
}

model Consent {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  sourceType    ExternalSourceType
  purpose       String // vd "IDENTITY_VERIFICATION" | "ENRICHMENT" | "MATCHING", free-text v1
  scopeNote     String?
  policyVersion String             @default("1.0")

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([expertProfileId, sourceType])
}

enum ExternalConnectionStatus {
  ENTERED
  MATCHED
  AUTHENTICATED
  DISPUTED
  REVOKED
}

model ExternalConnection {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  sourceType ExternalSourceType
  externalId String // id/dinh danh tai nguon ngoai, vd ORCID iD
  status     ExternalConnectionStatus @default(ENTERED)

  connectedAt DateTime  @default(now())
  revokedAt   DateTime?

  // Rang buoc "1 external identifier da AUTHENTICATED chi gan 1 golden profile"
  // (VC-NV-011 Muc 17.3) enforce o tang domain/action, chua co unique index
  // dieu kien (partial index) o Prisma v1 — xem ADR-0001 Muc 8.
  @@index([sourceType, externalId])
  @@index([expertProfileId, sourceType])
}

enum ProposalDecision {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
  SUPERSEDED
}

model FieldProposal {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  fieldPath            String // vd "headline", "bio"
  proposedValue        Json
  currentValueSnapshot Json?

  sourceType       ExternalSourceType
  sourceRecordId   String?
  sourceUrl        String?
  collectedAt      DateTime           @default(now())
  extractionMethod String? // "MOCK" o v1 (ADR-0001 Muc 8)
  confidence       Float
  evidence         String?
  conflictFlags    String[]

  decision     ProposalDecision @default(PENDING)
  decidedValue Json?
  decidedById  String?
  decidedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([expertProfileId, decision])
}

enum ExpertiseSource {
  SELF
  AI_SUGGESTED
  EVIDENCE
}

model Expertise {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  label       String // free-text (ADR-0001 Muc 6)
  source      ExpertiseSource @default(SELF)
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([expertProfileId, label])
}

enum CapabilityEvidenceType {
  PUBLICATION
  PROJECT
  CERTIFICATE
  PATENT
  TECHNOLOGY
  ORGANIZATION_VERIFICATION
}

model Capability {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  label              String // free-text (ADR-0001 Muc 6)
  verificationStatus VerificationStatus @default(UNVERIFIED)

  evidence CapabilityEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expertProfileId, label])
}

model CapabilityEvidence {
  id           String     @id @default(cuid())
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  type         CapabilityEvidenceType
  description  String
  referenceUrl String?

  createdAt DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfileClaim {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  claimantUserId  String
  claimant        User          @relation(fields: [claimantUserId], references: [id])

  status      ClaimStatus @default(PENDING)
  note        String?
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([expertProfileId, status])
}

enum IdentityMatchStatus {
  POTENTIAL_DUPLICATE
  LIKELY_SAME
  CONFIRMED_SAME
  DIFFERENT_PERSON
  MERGED
}

model IdentityMatch {
  id         String        @id @default(cuid())
  profileAId String
  profileA   ExpertProfile @relation("IdentityMatchA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileBId String
  profileB   ExpertProfile @relation("IdentityMatchB", fields: [profileBId], references: [id], onDelete: Cascade)

  score            Float
  signals          Json
  status           IdentityMatchStatus @default(POTENTIAL_DUPLICATE)
  algorithmVersion String              @default("adr-0001-v1")

  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([profileAId, profileBId])
  @@index([status])
}

model MergeHistory {
  id              String        @id @default(cuid())
  sourceProfileId String
  sourceProfile   ExpertProfile @relation("MergeSource", fields: [sourceProfileId], references: [id])
  targetProfileId String
  targetProfile   ExpertProfile @relation("MergeTarget", fields: [targetProfileId], references: [id])

  reason         String
  rollbackData   Json // snapshot du du de rollback (VC-NV-011 Muc 9.3)
  approvedById   String
  approvedAt     DateTime  @default(now())
  rolledBackAt   DateTime?
  rolledBackById String?

  createdAt DateTime @default(now())

  @@index([targetProfileId])
}

// ---------- CAU PHAN 03: TRI THUC & DU LIEU (VC-NV-013 / VC-KT-013) ----------
// V1: chi Publication, ADMIN/SUPERADMIN tao (chua mo EXPERT tu dang - quyet
// dinh Product Owner 2026-08-20). Tac gia luu String[] (nameRaw tho, khop
// thang voi CrossrefWork.authors) thay vi bang PublicationAuthor rieng vi
// chua can lien ket ExpertProfile khi chua co self-service — xem VC-KT-013
// Muc 6.1, 11 diem 5. Patent/Dataset/Knowledge/Evidence van la backlog.

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  BOOK_CHAPTER
  PREPRINT
  TECHNICAL_REPORT
  OTHER
}

model Publication {
  id             String          @id @default(cuid())
  title          String
  abstract       String?
  type           PublicationType @default(OTHER)
  containerTitle String?
  year           Int?
  fields         String[]
  authors        String[]

  doi        String?            @unique
  sourceType ExternalSourceType @default(INTERNAL)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus, type])
}

// ---------- DISCOVER & MATCH ----------

enum NeedStatus {
  DRAFT
  PUBLISHED
  MATCHED
  CLOSED
}

model Need {
  id             String       @id @default(cuid())
  title          String
  description    String
  fields         String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  budgetVnd      BigInt?
  status         NeedStatus   @default(DRAFT)
  attachmentPath String? // đường dẫn tương đối trong uploads/, không phải public/ — xem app/api/needs/[id]/attachment
  attachmentName String? // tên file gốc do người dùng đặt, hiển thị khi tải xuống
  matches        Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum SupplyType {
  TECHNOLOGY
  SOLUTION
  EXPERT_SERVICE
  PATENT
}

enum SupplyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Supply {
  id              String         @id @default(cuid())
  title           String
  description     String
  type            SupplyType
  fields          String[]
  trl             Int? // technology readiness level 1-9
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  expertProfileId String?
  expertProfile   ExpertProfile? @relation(fields: [expertProfileId], references: [id])
  status          SupplyStatus   @default(DRAFT)
  matches         Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
}

enum MatchStage {
  SUGGESTED
  VIEWED
  ACCEPTED
  CONTACTED
  COLLABORATING
  CONVERTED_PROJECT
  REJECTED
}

model Match {
  id     String @id @default(cuid())
  needId String
  need   Need   @relation(fields: [needId], references: [id])

  supplyId String?
  supply   Supply? @relation(fields: [supplyId], references: [id])

  expertProfileId String?
  expertProfile   ExpertProfile? @relation("ExpertMatches", fields: [expertProfileId], references: [id])

  score   Float // 0..1 explainable score
  reasons Json // structured explanation, e.g. [{factor:"field_overlap", weight:0.4, detail:"..."}]
  stage   MatchStage @default(SUGGESTED)

  project Project?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([needId, stage])
}

enum ChallengeStatus {
  INTAKE
  STANDARDIZING
  PUBLISHED
  SOLUTION_REVIEW
  MATCHED
  CLOSED
}

model Challenge {
  id             String          @id @default(cuid())
  title          String
  problem        String
  goal           String?
  constraints    String?
  fields         String[]
  trl            Int?
  budgetVnd      BigInt?
  hasBudget      Boolean         @default(false)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  status         ChallengeStatus @default(INTAKE)
  attachmentPath String? // đường dẫn tương đối trong uploads/, không phải public/ — xem app/api/challenges/[id]/attachment
  attachmentName String? // tên file gốc do người dùng đặt, hiển thị khi tải xuống
  solutions      Solution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum SolutionStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  SELECTED
  REJECTED
}

model Solution {
  id            String         @id @default(cuid())
  challengeId   String
  challenge     Challenge      @relation(fields: [challengeId], references: [id])
  submittedById String
  summary       String
  approach      String
  status        SolutionStatus @default(SUBMITTED)
  reviewScore   Float?
  reviewNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([challengeId, status])
}

// ---------- EXECUTE ----------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  TERMINATED
}

model Project {
  id      String        @id @default(cuid())
  matchId String?       @unique
  match   Match?        @relation(fields: [matchId], references: [id])
  title   String
  summary String?
  status  ProjectStatus @default(PLANNING)

  milestones  Milestone[]
  agreement   Agreement?
  evaluations Evaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  OVERDUE
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?
  status       MilestoneStatus @default(PLANNED)
  deliverables Deliverable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

model Deliverable {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String?
  accepted    Boolean   @default(false)

  createdAt DateTime @default(now())
}

enum AgreementType {
  MOU
  NDA
  RESEARCH_AGREEMENT
  SERVICE_CONTRACT
  TECH_TRANSFER
}

enum AgreementStatus {
  DRAFT
  SIGNED
  COMPLETED
  TERMINATED
}

model Agreement {
  id        String          @id @default(cuid())
  projectId String          @unique
  project   Project         @relation(fields: [projectId], references: [id])
  type      AgreementType
  status    AgreementStatus @default(DRAFT)
  valueVnd  BigInt?
  signedAt  DateTime?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Cấu phần 08: Thẩm định & Đánh giá (v1 — chỉ Evaluation, xem VC-KT-018) ----------

/** Đánh giá hiệu quả dự án — append-only, có thể đánh giá nhiều lần trong vòng đời (VC-KT-018 Mục 5). */
model Evaluation {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluatedById String
  evaluatedBy   User    @relation(fields: [evaluatedById], references: [id])

  score    Float // 0..1, cùng thang với Match.score/Solution.reviewScore
  criteria String // free-text tiêu chí đánh giá (ADR-0001 Mục 6)
  note     String?

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---------- MOBILIZE (stub only — Funding & Investment Hub thật là backlog) ----------

model FundingSource {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fields         String[]
  note           String?

  createdAt DateTime @default(now())
}

// ---------- IMPACT ----------

model KpiSnapshot {
  id           String   @id @default(cuid())
  capturedAt   DateTime @default(now())
  connectCount Int
  matchCount   Int
  mobilizeVnd  BigInt
  impactCount  Int
  raw          Json
}

// ---------- GOVERNANCE / AUDIT ----------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
